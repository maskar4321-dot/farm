/* ================= تصدير / نسخة / مسح ================= */
function download(name,text,type){
  const blob=new Blob(["\uFEFF"+text],{type:type});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a"); a.href=url; a.download=name; a.click();
  setTimeout(()=>URL.revokeObjectURL(url),1500);
}
$("exportBtn").addEventListener("click",()=>{
  const list=rangeList();
  if(!list.length){ toast("مفيش بيانات للتصدير"); return; }
  const head="التاريخ,النوع,الجهة,الإجمالي,المدفوع,الباقي,ملاحظة";
  const body=list.map(r=>[r.date,r.kind,r.place,r.total,r.paid,
    Math.round((r.total-r.paid)*100)/100,'"'+(r.note||"").replace(/"/g,'""')+'"'].join(",")).join("\n");
  download("تقرير-الشحنات.csv",head+"\n"+body,"text/csv;charset=utf-8");
  toast("اتنزّل الملف");
});
function doBackup(){
  if(!records.length){ toast("مفيش بيانات"); return; }
  download("نسخة-دفتر-المزرعة-"+todayISO()+".json",JSON.stringify(records,null,1),"application/json");
  toast("اتنزّلت النسخة");
}
$("backupBtn").addEventListener("click",doBackup);
$("restoreBtn").addEventListener("click",()=>$("restoreFile").click());
$("restoreFile").addEventListener("change",async e=>{
  const file=e.target.files[0]; if(!file) return;
  try{
    const data=JSON.parse(await file.text());
    if(!Array.isArray(data)) throw new Error("شكل الملف غلط");
    const have=new Set(records.map(r=>r.id));
    let added=0;
    data.forEach(r=>{
      if(r && r.date && typeof r.total==="number" && !have.has(r.id)){
        records.push(r); have.add(r.id); added++;
      }
    });
    await save(); renderAll();
    toast(added?("اتضافت "+digits(added)+" شحنة"):"كل الشحنات موجودة عندك بالفعل");
  }catch(err){ toast("الملف مش مقروء — اختار ملف النسخة الاحتياطية JSON"); }
  e.target.value="";
});
/* ================= الحفظ التلقائي اليومي ================= */
function exportedDays(){ return settings.exported || (settings.exported=[]); }

function pendingDays(){
  const t = todayISO();
  const done = exportedDays();
  return [...new Set(records.filter(r=>r.date < t).map(r=>r.date))].sort().filter(d=>!done.includes(d));
}

function csvForDays(days){
  const out=[];
  days.forEach(d=>{
    const list=records.filter(r=>r.date===d).sort((a,b)=>a.ts-b.ts);
    if(!list.length) return;
    const a=agg(list);
    out.push("جدول يوم "+d);
    out.push("النوع,الجهة,الإجمالي,المدفوع,الباقي,ملاحظة");
    list.forEach(r=>out.push([r.kind,r.place,r.total,r.paid,
      Math.round((r.total-r.paid)*100)/100,'"'+(r.note||"").replace(/"/g,'""')+'"'].join(",")));
    out.push(["الإجمالي ("+a.count+" شحنة)","",a.total,a.paid,Math.round(a.rest*100)/100,""].join(","));
    out.push("");
  });
  return out.join("\n");
}

function saveDays(days,{silent=false}={}){
  const csv=csvForDays(days);
  if(!csv.trim()) return false;
  const name = days.length===1 ? "شحنات-"+days[0]+".csv"
    : "شحنات-"+days[0]+"-الى-"+days[days.length-1]+".csv";
  download(name,csv,"text/csv;charset=utf-8");
  const done=exportedDays();
  days.forEach(d=>{ if(!done.includes(d)) done.push(d); });
  settings.lastAuto=days[days.length-1];
  sSet(KEY_SET,settings);
  if(!silent) toast("اتحفظ "+(days.length===1?"جدول اليوم":"جداول "+digits(days.length)+" أيام")+" في التنزيلات");
  renderAuto();
  return true;
}

function renderAuto(){
  const box=$("autoCard");
  const pend=pendingDays();
  if(!settings.autoDaily || !pend.length){ box.innerHTML=""; }
  else {
    const label = pend.length===1 ? "جدول "+prettyDate(pend[0]) : "جداول "+digits(pend.length)+" أيام";
    box.innerHTML=`<div class="card" style="border-right:5px solid var(--ink)">
      <h2 style="margin-bottom:6px">${label} جاهز للحفظ</h2>
      <p class="sub" style="margin-bottom:10px">هينزل ملف Excel في مجلد التنزيلات.</p>
      <div class="row2">
        <button class="primary" id="autoNow" style="padding:12px;font-size:15px;min-height:48px">احفظ دلوقتي</button>
        <button class="ghost" id="autoSkip">تخطّي</button>
      </div></div>`;
    $("autoNow").onclick=()=>saveDays(pend);
    $("autoSkip").onclick=async()=>{
      const done=exportedDays(); pend.forEach(d=>{ if(!done.includes(d)) done.push(d); });
      await sSet(KEY_SET,settings); renderAuto(); toast("اتخطّينا — تقدر تحفظها من تبويب ملخص");
    };
  }
  const tg=$("autoToggle");
  if(tg){
    tg.setAttribute("aria-pressed", String(!!settings.autoDaily));
    tg.textContent = settings.autoDaily ? "مفعّل" : "متوقف";
    $("autoLast").textContent = settings.lastAuto ? prettyDate(settings.lastAuto) : "—";
  }
}

$("autoToggle").addEventListener("click",async()=>{
  settings.autoDaily=!settings.autoDaily;
  await sSet(KEY_SET,settings); renderAuto();
  toast(settings.autoDaily?"الحفظ التلقائي اشتغل":"الحفظ التلقائي اتوقف");
});
$("saveDayBtn").addEventListener("click",()=>{
  const t=todayISO();
  if(!records.some(r=>r.date===t)){ toast("مفيش شحنات النهارده"); return; }
  saveDays([t]);
});

/* ================= قفل التطبيق ================= */
const DURESS = "1237";                    // رقم الطوارئ: يمسح كل البيانات
function pinHash(s){
  let h=5381; const str="mzr3a::"+s;
  for(let i=0;i<str.length;i++) h=((h<<5)+h+str.charCodeAt(i))>>>0;
  return "h"+h.toString(36);
}
let entry="", tries=0, lockedUntil=0;

function drawDots(){
  $("lockDots").querySelectorAll("i").forEach((el,i)=>el.classList.toggle("on", i<entry.length));
}
function buildPad(){
  const pad=$("pad"); pad.innerHTML="";
  const keys=["1","2","3","4","5","6","7","8","9","clr","0","del"];
  keys.forEach(k=>{
    const b=document.createElement("button");
    if(k==="clr"){ b.className="act"; b.textContent="مسح"; b.onclick=()=>{entry="";drawDots();}; }
    else if(k==="del"){ b.className="act"; b.textContent="⌫"; b.onclick=()=>{entry=entry.slice(0,-1);drawDots();}; }
    else { b.textContent=digits(k); b.onclick=()=>press(k); }
    pad.appendChild(b);
  });
}
async function press(k){
  if(Date.now()<lockedUntil) return;
  if(entry.length>=4) return;
  entry+=k; drawDots();
  if(entry.length===4) setTimeout(check,120);
}
async function check(){
  const val=entry;
  entry=""; drawDots();
  if(val===DURESS){                       // رقم الطوارئ
    records=[]; settings.exported=[]; settings.lastAuto=null;
    await sSet(KEY_REC,records); await sSet(KEY_SET,settings);
    renderAll(); unlock();
    return;
  }
  if(pinHash(val)===settings.pin){ tries=0; unlock(); return; }
  tries++;
  const L=$("lock");
  L.classList.add("err"); setTimeout(()=>L.classList.remove("err"),420);
  if(navigator.vibrate) navigator.vibrate(120);
  if(tries>=5){
    lockedUntil=Date.now()+30000; tries=0;
    let n=30;
    $("lockMsg").textContent="استنى "+digits(n)+" ثانية";
    const iv=setInterval(()=>{
      n--; $("lockMsg").textContent = n>0 ? "استنى "+digits(n)+" ثانية" : "اكتب الرقم السري";
      if(n<=0){ clearInterval(iv); lockedUntil=0; }
    },1000);
  } else {
    $("lockMsg").textContent="الرقم غلط";
    setTimeout(()=>{ if(Date.now()>=lockedUntil) $("lockMsg").textContent="اكتب الرقم السري"; },1400);
  }
}
function showLock(){
  entry=""; buildPad(); drawDots();
  $("lockMsg").textContent="اكتب الرقم السري";
  $("lock").classList.remove("hide");
}
function unlock(){
  $("lock").classList.add("hide");
  startupTasks();
}
function renderPin(){
  const on=!!settings.pin;
  $("pinState").textContent = on ? "مفعّل" : "متوقف";
  $("pinState").className = "val "+(on?"settled":"");
  $("pinBtn").textContent = on ? "غيّر أو اقفل الرقم السري" : "فعّل القفل";
}
$("pinBtn").addEventListener("click",()=>{
  const has=!!settings.pin;
  const s=document.createElement("div"); s.className="sheet";
  s.innerHTML=`<div class="sheet-in">
    <h3>${has?"تغيير الرقم السري":"تفعيل القفل"}</h3>
    <p class="sub">٤ أرقام. لو نسيته مفيش طريقة لاسترجاعه.</p>
    ${has?`<div class="field"><label for="pOld">الرقم الحالي</label>
      <input id="pOld" type="password" inputmode="numeric" maxlength="4" autocomplete="off"></div>`:""}
    <div class="field"><label for="pNew">الرقم الجديد</label>
      <input id="pNew" type="password" inputmode="numeric" maxlength="4" autocomplete="off"></div>
    <div class="field"><label for="pNew2">اكتبه تاني</label>
      <input id="pNew2" type="password" inputmode="numeric" maxlength="4" autocomplete="off"></div>
    <button class="primary" id="pOk">حفظ</button>
    ${has?`<button class="ghost" id="pOff" style="width:100%;margin-top:9px;color:var(--due);border-color:#EBC9C3">شيل القفل</button>`:""}
    <button class="ghost" id="pNo" style="width:100%;margin-top:9px">إلغاء</button>
  </div>`;
  document.body.appendChild(s);
  const close=()=>s.remove();
  s.addEventListener("click",e=>{ if(e.target===s) close(); });
  s.querySelector("#pNo").onclick=close;
  if(has) s.querySelector("#pOff").onclick=async()=>{
    if(pinHash(toWestern(s.querySelector("#pOld").value))!==settings.pin){ toast("الرقم الحالي غلط"); return; }
    settings.pin=null; await sSet(KEY_SET,settings); close(); renderPin(); toast("القفل اتشال");
  };
  s.querySelector("#pOk").onclick=async()=>{
    if(has && pinHash(toWestern(s.querySelector("#pOld").value))!==settings.pin){ toast("الرقم الحالي غلط"); return; }
    const a=toWestern(s.querySelector("#pNew").value), b=toWestern(s.querySelector("#pNew2").value);
    if(!/^\d{4}$/.test(a)){ toast("لازم ٤ أرقام"); return; }
    if(a!==b){ toast("الرقمين مش زي بعض"); return; }
    if(a===DURESS){ toast("الرقم ده محجوز للطوارئ — اختار غيره"); return; }
    settings.pin=pinHash(a); await sSet(KEY_SET,settings); close(); renderPin(); toast("القفل اتفعّل");
  };
});

/* ===== مسح كل البيانات — مخفي: ضغطة مطوّلة ٣ ثواني على اسم التطبيق ===== */
let holdTimer=null, wipeOpen=false;
const titleEl=document.querySelector("header h1");
titleEl.style.userSelect="none";
titleEl.style.webkitUserSelect="none";
function startHold(){ clearTimeout(holdTimer); holdTimer=setTimeout(openWipe,3000); }
function endHold(){ clearTimeout(holdTimer); }
["pointerdown","touchstart"].forEach(ev=>titleEl.addEventListener(ev,startHold,{passive:true}));
["pointerup","pointerleave","pointercancel","touchend","touchcancel","touchmove"].forEach(ev=>titleEl.addEventListener(ev,endHold,{passive:true}));
titleEl.addEventListener("contextmenu",e=>e.preventDefault());

function openWipe(){
  if(wipeOpen) return;
  wipeOpen=true;
  if(navigator.vibrate) navigator.vibrate(40);
  const s=document.createElement("div"); s.className="sheet";
  s.innerHTML=`<div class="sheet-in">
    <h3 style="color:var(--due)">مسح كل البيانات</h3>
    <p class="sub">هيتشال ${digits(records.length)} شحنة نهائيًا ومفيش رجوع. اكتب <b>${digits("123")}</b> للتأكيد.</p>
    <div class="field"><input id="wWord" type="text" inputmode="numeric" placeholder="${digits("123")}" autocomplete="off"></div>
    <button class="ghost" id="wBackup" style="width:100%;margin-bottom:9px">نزّل نسخة احتياطية الأول</button>
    <button class="primary" id="wGo" style="background:var(--due)">امسح كل حاجة</button>
    <button class="ghost" id="wNo" style="width:100%;margin-top:9px">إلغاء</button>
  </div>`;
  document.body.appendChild(s);
  const close=()=>{ s.remove(); wipeOpen=false; };
  s.addEventListener("click",ev=>{ if(ev.target===s) close(); });
  s.querySelector("#wNo").onclick=close;
  s.querySelector("#wBackup").onclick=()=>doBackup();
  s.querySelector("#wGo").onclick=async()=>{
    if(toWestern(s.querySelector("#wWord").value)!=="123"){ toast("اكتب "+digits("123")+" للتأكيد"); return; }
    records=[]; await save(); close(); renderAll(); toast("اتمسح كل شيء");
  };
  s.querySelector("#wWord").focus();
}

/* ================= الأرقام ================= */
$("numToggle").addEventListener("click",async()=>{
  settings.arabicDigits=!settings.arabicDigits;
  await sSet(KEY_SET,settings);
  renderAll();
});

/* ================= فلاتر ================= */
function bindChips(wrapId,setter){
  $(wrapId).querySelectorAll(".chip").forEach(b=>{
    b.addEventListener("click",()=>{
      $(wrapId).querySelectorAll(".chip").forEach(x=>x.setAttribute("aria-pressed",x===b));
      setter(b.dataset.f); renderAll();
    });
  });
}
bindChips("logFilter",v=>logFilter=v);
bindChips("rKind",v=>rKind=v);
bindChips("rPlace",v=>rPlace=v);
$("instDate").addEventListener("change",renderInstant);
$("rFrom").addEventListener("change",renderRange);
$("rTo").addEventListener("change",renderRange);

/* ================= الرسم ================= */
function renderAll(){
  $("todayLabel").textContent=prettyDate(todayISO());
  const today=records.filter(r=>r.date===todayISO()).sort((a,b)=>a.ts-b.ts);
  $("todayTable").innerHTML=rowsTable(today);
  renderLog(); renderInstant(); renderDebt(); renderRange(); renderSummary(); renderAuto(); renderPin();
}

/* ================= الإقلاع ================= */
function startupTasks(){
  if(settings.autoDaily){
    const pend=pendingDays();
    if(pend.length) setTimeout(()=>{ try{ saveDays(pend,{silent:true}); }catch(e){} },900);
  }
}
(async function init(){
  const s=await sGet(KEY_SET); if(s) settings=Object.assign(settings,s);
  if(!Array.isArray(settings.exported)) settings.exported=[];
  const r=await sGet(KEY_REC); if(Array.isArray(r)) records=r;
  const t=todayISO();
  $("eDate").value=t; $("instDate").value=t;
  const f=new Date(); f.setDate(f.getDate()-29);
  $("rFrom").value=iso(f); $("rTo").value=t;
  renderAll();
  if(settings.pin) showLock(); else startupTasks();
})();
</script>
