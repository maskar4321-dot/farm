/* ================= أسبوعي / شهري ================= */
function weekStart(isoStr){           // الأسبوع من الإثنين للأحد
  const [y,m,d]=isoStr.split("-").map(Number);
  const dt=new Date(y,m-1,d);
  const back=(dt.getDay()+6)%7;       // الإثنين=1 -> 0 ، الأحد=0 -> 6
  dt.setDate(dt.getDate()-back);
  return iso(dt);
}
function weekEnd(startIso){
  const [y,m,d]=startIso.split("-").map(Number);
  const dt=new Date(y,m-1,d+6);
  return iso(dt);
}
function periodTable(keyFn,labelFn,limit){
  const map=new Map();
  records.forEach(r=>{ const k=keyFn(r.date); if(!map.has(k)) map.set(k,[]); map.get(k).push(r); });
  const keys=[...map.keys()].sort().reverse().slice(0,limit);
  if(!keys.length) return '<div class="empty"><b>لسه مفيش بيانات</b>الملخص هيظهر بعد أول شحنة.</div>';
  const rows=keys.map(k=>{
    const list=map.get(k);
    const v=agg(list.filter(r=>r.kind==="خضار")), f=agg(list.filter(r=>r.kind==="فاكهة")), t=agg(list);
    return `<tr>
      <td>${labelFn(k)}</td>
      <td class="num">${digits(v.count)}</td><td class="num">${digits(v.settled)}</td><td>${signed(v.rest)}</td>
      <td class="num">${digits(f.count)}</td><td class="num">${digits(f.settled)}</td><td>${signed(f.rest)}</td>
      <td class="num">${digits(t.count)}</td><td>${signed(t.rest)}</td></tr>`;
  }).join("");
  const all=agg(records.filter(r=>keys.includes(keyFn(r.date))));
  const av=agg(records.filter(r=>keys.includes(keyFn(r.date))&&r.kind==="خضار"));
  const af=agg(records.filter(r=>keys.includes(keyFn(r.date))&&r.kind==="فاكهة"));
  return `<div class="tw"><table style="min-width:640px">
    <thead>
      <tr><th rowspan="2">الفترة</th><th colspan="3" style="text-align:center;color:var(--veg)">خضار</th>
          <th colspan="3" style="text-align:center;color:var(--fruit)">فاكهة</th>
          <th colspan="2" style="text-align:center">الإجمالي</th></tr>
      <tr><th>شحنات</th><th>مسدّدة</th><th>دين</th><th>شحنات</th><th>مسدّدة</th><th>دين</th><th>شحنات</th><th>دين</th></tr>
    </thead>
    <tbody>${rows}</tbody>
    <tfoot><tr><td>المجموع</td>
      <td class="num">${digits(av.count)}</td><td class="num">${digits(av.settled)}</td><td>${signed(av.rest)}</td>
      <td class="num">${digits(af.count)}</td><td class="num">${digits(af.settled)}</td><td>${signed(af.rest)}</td>
      <td class="num">${digits(all.count)}</td><td>${signed(all.rest)}</td></tr></tfoot>
  </table></div>`;
}
