function syncFromTotal(){
  const t=parseNum($("eTotal").value);
  if(t===null) return;
  if(form.lastEdited==="rest"){
    const r=parseNum($("eRest").value);
    if(r!==null) $("ePaid").value = String(Math.round((t-r)*100)/100);
  } else {
    const p=parseNum($("ePaid").value);
    if(p!==null) $("eRest").value = String(Math.round((t-p)*100)/100);
  }
}
$("eTotal").addEventListener("input",syncFromTotal);
$("ePaid").addEventListener("input",()=>{
  form.lastEdited="paid";
  const t=parseNum($("eTotal").value), p=parseNum($("ePaid").value);
  if(t!==null && p!==null) $("eRest").value=String(Math.round((t-p)*100)/100);
});
$("eRest").addEventListener("input",()=>{
  form.lastEdited="rest";
  const t=parseNum($("eTotal").value), r=parseNum($("eRest").value);
  if(t!==null && r!==null) $("ePaid").value=String(Math.round((t-r)*100)/100);
});

$("saveBtn").addEventListener("click",async()=>{
  const total=parseNum($("eTotal").value);
  if(total===null){ toast("اكتب المبلغ الإجمالي الأول"); $("eTotal").focus(); return; }
  let paid=parseNum($("ePaid").value);
  const rest=parseNum($("eRest").value);
  if(paid===null) paid = (rest===null) ? 0 : total-rest;
  const d=$("eDate").value || todayISO();
  records.push({
    id:"r"+Date.now()+Math.random().toString(36).slice(2,6),
    date:d, kind:form.kind, place:form.place,
    total:total, paid:paid,
    note:$("eNote").value.trim(), ts:Date.now()
  });
  await save();
  $("eTotal").value=""; $("ePaid").value=""; $("eRest").value=""; $("eNote").value="";
  form.lastEdited="paid";
  toast("اتسجلت: "+form.kind+" — "+form.place+" — "+money(total));
  renderAll();
  $("eTotal").focus();
});

/* ================= تحصيل / حذف ================= */
document.addEventListener("click",async e=>{
  const c=e.target.closest("[data-collect]");
  if(c){ openCollect(c.dataset.collect); return; }
  const d=e.target.closest("[data-del]");
  if(d){
    const r=records.find(x=>x.id===d.dataset.del);
    if(r && confirm("تمسح شحنة "+r.kind+" — "+r.place+" بمبلغ "+money(r.total)+"؟")){
      records=records.filter(x=>x.id!==r.id);
      await save(); renderAll(); toast("اتمسحت");
    }
  }
});

function openCollect(id){
  const r=records.find(x=>x.id===id); if(!r) return;
  const due=r.total-r.paid;
  const s=document.createElement("div"); s.className="sheet";
  s.innerHTML=`<div class="sheet-in">
    <h3>تحصيل دفعة</h3>
    <p class="sub">${esc(r.kind)} — ${esc(r.place)} — شحنة ${shortDate(r.date)} · المتبقي ${money(due)}</p>
    <div class="field"><label for="cAmt">المبلغ المحصّل</label>
      <input id="cAmt" type="text" inputmode="decimal" placeholder="${toWestern(String(Math.round(due*100)/100))}"></div>
    <div class="row2">
      <button class="primary" id="cOk">أضف الدفعة</button>
      <button class="ghost" id="cAll">حصّلت المتبقي كله</button>
    </div>
    <button class="ghost" id="cNo" style="width:100%;margin-top:9px">إلغاء</button>
  </div>`;
  document.body.appendChild(s);
  const close=()=>s.remove();
  s.addEventListener("click",ev=>{ if(ev.target===s) close(); });
  s.querySelector("#cNo").onclick=close;
  s.querySelector("#cAll").onclick=async()=>{ r.paid=r.total; await save(); close(); renderAll(); toast("الشحنة اتسدّدت بالكامل"); };
  s.querySelector("#cOk").onclick=async()=>{
    const a=parseNum(s.querySelector("#cAmt").value);
    if(a===null){ toast("اكتب المبلغ"); return; }
    r.paid+=a; await save(); close(); renderAll(); toast("اتضافت دفعة "+money(a));
  };
  s.querySelector("#cAmt").focus();
}

/* ================= جداول ================= */
function rowsTable(list,{showDate=false,actions=true}={}){
  if(!list.length) return '<div class="empty">مفيش شحنات هنا.</div>';
  let T=0,P=0;
  const body=list.map(r=>{
    T+=r.total; P+=r.paid;
    return `<tr>
      ${showDate?`<td class="num">${shortDate(r.date)}</td>`:""}
      <td><span class="tag ${r.kind==="خضار"?"veg":"fruit"}">${esc(r.kind)}</span></td>
      <td>${esc(r.place)}</td>
      <td class="money">${money(r.total)}</td>
      <td class="money">${money(r.paid)}</td>
      <td>${restCell(r)}</td>
      <td>${esc(r.note||"—")}</td>
      ${actions?`<td><button class="rowbtn" data-collect="${r.id}">تحصيل</button>
        <button class="rowbtn del" data-del="${r.id}">حذف</button></td>`:""}
    </tr>`;
  }).join("");
  const cols = (showDate?1:0)+2;
  return `<div class="tw"><table>
    <thead><tr>
      ${showDate?"<th>التاريخ</th>":""}<th>النوع</th><th>الجهة</th>
      <th>الإجمالي</th><th>المدفوع</th><th>الباقي</th><th>ملاحظة</th>${actions?"<th></th>":""}
    </tr></thead>
    <tbody>${body}</tbody>
    <tfoot><tr>
      <td colspan="${cols}">الإجمالي (${digits(list.length)} شحنة)</td>
      <td class="money">${money(T)}</td><td class="money">${money(P)}</td>
      <td>${signed(T-P)}</td><td></td>${actions?"<td></td>":""}
    </tr></tfoot></table></div>`;
}

function agg(list){
  const a={count:list.length,total:0,paid:0,rest:0,settled:0};
  list.forEach(r=>{ a.total+=r.total; a.paid+=r.paid; const v=r.total-r.paid; a.rest+=v; if(v<0.005) a.settled++; });
  return a;
}

