<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>دفتر شحنات المزرعة</title>
<meta name="theme-color" content="#14251C">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style>
:root{
  --field:#E9EDE4;
  --paper:#FFFFFF;
  --ink:#14251C;
  --ink-soft:#5A6B5F;
  --line:#CBD5C6;
  --veg:#2F6B3C;
  --veg-bg:#E4EFE3;
  --fruit:#A4243B;
  --fruit-bg:#F7E6E8;
  --due:#B3321E;
  --credit:#1D5C77;
  --ok:#2F6B3C;
  --r:14px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  font-family:"Noto Sans Arabic","Noto Naskh Arabic","Droid Arabic Naskh",-apple-system,"Segoe UI",system-ui,sans-serif;
  background:var(--field);color:var(--ink);
  font-size:16px;line-height:1.55;
  padding-bottom:calc(84px + env(safe-area-inset-bottom));
  -webkit-font-smoothing:antialiased;
}
.num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1}
button,input,select{font-family:inherit;font-size:inherit;color:inherit}
button{cursor:pointer;border:none;background:none}
:focus-visible{outline:3px solid #14251C;outline-offset:2px;border-radius:6px}

/* ===== شريط علوي ===== */
header{
  position:sticky;top:0;z-index:30;
  background:var(--ink);color:#EDF2EA;
  padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding-top:calc(12px + env(safe-area-inset-top));
}
header h1{margin:0;font-size:17px;font-weight:700;letter-spacing:-.2px}
header .today{font-size:13px;color:#A7BCA9;font-weight:500}
.hdr-btn{background:rgba(255,255,255,.12);color:#EDF2EA;border-radius:9px;padding:6px 11px;font-size:13px;font-weight:600}

main{max-width:760px;margin:0 auto;padding:14px 12px 24px}

/* ===== بطاقات ===== */
.card{background:var(--paper);border-radius:var(--r);padding:14px;margin-bottom:12px;border:1px solid var(--line)}
.card > h2{margin:0 0 12px;font-size:15px;font-weight:700}
.sub{color:var(--ink-soft);font-size:13px;margin:0 0 12px}

/* ===== اختيار مجزّأ ===== */
.seg{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.seg button{
  border:1.5px solid var(--line);background:#fff;border-radius:12px;
  padding:14px 8px;font-weight:600;font-size:16px;color:var(--ink-soft);
  display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;
  transition:background .12s,color .12s,border-color .12s;
}
.seg button .dot{width:10px;height:10px;border-radius:50%;background:currentColor;opacity:.45}
.seg button[aria-pressed="true"]{color:#fff;border-color:transparent}
.seg button[aria-pressed="true"] .dot{opacity:1;background:#fff}
.seg.kind button[aria-pressed="true"][data-v="خضار"]{background:var(--veg)}
.seg.kind button[aria-pressed="true"][data-v="فاكهة"]{background:var(--fruit)}
.seg.place button[aria-pressed="true"]{background:var(--ink)}

/* ===== حقول ===== */
label{display:block;font-size:13px;font-weight:600;color:var(--ink-soft);margin:0 0 5px}
input[type=text],input[type=date],input[type=number]{
  width:100%;padding:12px;border:1.5px solid var(--line);border-radius:11px;background:#fff;
}
input::placeholder{color:#9FAF9F}
.big-amount input{font-size:26px;font-weight:700;padding:12px 14px;letter-spacing:-.5px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.field{margin-bottom:12px}
.hint{font-size:12px;color:var(--ink-soft);margin-top:5px}
.locked{background:#F1F4EF;color:var(--ink-soft)}

.primary{
  width:100%;background:var(--ink);color:#fff;border-radius:12px;padding:16px;
  font-weight:700;font-size:17px;min-height:56px;
}
.primary:disabled{opacity:.4}
.ghost{border:1.5px solid var(--line);background:#fff;border-radius:11px;padding:11px;font-weight:600;font-size:14px}

/* ===== جداول ===== */
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -14px}
table{border-collapse:collapse;width:100%;min-width:480px;font-size:14px}
th,td{padding:9px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
thead th{
  font-size:12px;font-weight:600;color:var(--ink-soft);
  background:#F3F6F1;border-bottom:1.5px solid var(--line);position:sticky;top:0;
}
tbody tr:last-child td{border-bottom:none}
tfoot td{font-weight:700;background:#F3F6F1;border-top:1.5px solid var(--ink);border-bottom:none}
td.money{font-variant-numeric:tabular-nums}
.tag{display:inline-block;padding:2px 9px;border-radius:99px;font-size:12px;font-weight:600}
.tag.veg{background:var(--veg-bg);color:var(--veg)}
.tag.fruit{background:var(--fruit-bg);color:var(--fruit)}
.due{color:var(--due);font-weight:700}
.credit{color:var(--credit);font-weight:700}
.settled{color:var(--ok);font-weight:600}
.rowbtn{font-size:13px;font-weight:600;color:var(--ink);border:1.5px solid var(--line);border-radius:8px;padding:5px 9px;background:#fff}
.rowbtn.del{color:var(--due);border-color:#EBC9C3}

/* ===== يوم ===== */
.day{margin-bottom:16px}
.day-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding:0 2px 8px}
.day-head .d{font-weight:700;font-size:15px}
.day-head .n{font-size:13px;color:var(--ink-soft)}

/* ===== ملخص لحظي ===== */
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{border:1.5px solid var(--line);border-radius:12px;padding:12px;background:#fff}
.stat.veg{border-right:5px solid var(--veg)}
.stat.fruit{border-right:5px solid var(--fruit)}
.stat .k{font-size:13px;font-weight:600;color:var(--ink-soft)}
.stat .v{font-size:27px;font-weight:700;letter-spacing:-1px;margin:2px 0;line-height:1.15}
.stat .m{font-size:13px;color:var(--ink-soft)}
.balance{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}
.balance:last-child{border-bottom:none}
.balance .lbl{font-weight:600;font-size:14px}
.balance .val{font-size:18px;font-weight:700;font-variant-numeric:tabular-nums}

.chips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:99px;padding:8px 14px;font-size:14px;font-weight:600;color:var(--ink-soft)}
.chip[aria-pressed="true"]{background:var(--ink);color:#fff;border-color:var(--ink)}

/* ===== تبويبات سفلية ===== */
nav{
  position:fixed;bottom:0;right:0;left:0;z-index:40;
  background:var(--paper);border-top:1px solid var(--line);
  display:grid;grid-template-columns:repeat(4,1fr);
  padding-bottom:env(safe-area-inset-bottom);
}
nav button{padding:9px 4px 11px;font-size:12px;font-weight:600;color:var(--ink-soft);display:flex;flex-direction:column;align-items:center;gap:3px}
nav button svg{width:23px;height:23px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav button[aria-current="page"]{color:var(--ink)}
nav button[aria-current="page"] svg{stroke-width:2.2}

.empty{text-align:center;padding:26px 16px;color:var(--ink-soft);font-size:14px}
.empty b{display:block;color:var(--ink);font-size:15px;margin-bottom:4px}
.hide{display:none!important}

/* ===== نافذة ===== */
.sheet{position:fixed;inset:0;z-index:60;display:flex;align-items:flex-end;justify-content:center;background:rgba(20,37,28,.45)}
.sheet-in{background:#fff;width:100%;max-width:760px;border-radius:18px 18px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom))}
.sheet-in h3{margin:0 0 4px;font-size:17px}
.toast{
  position:fixed;bottom:calc(92px + env(safe-area-inset-bottom));right:50%;transform:translateX(50%);
  background:var(--ink);color:#fff;padding:11px 18px;border-radius:99px;font-size:14px;font-weight:600;
  z-index:70;box-shadow:0 6px 18px rgba(20,37,28,.28);max-width:90vw;text-align:center;
}
@media (prefers-reduced-motion:no-preference){
  .toast{animation:pop .22s ease-out}
  @keyframes pop{from{opacity:0;transform:translate(50%,10px)}to{opacity:1;transform:translate(50%,0)}}
}
@media(min-width:560px){ .stats{grid-template-columns:repeat(4,1fr)} }

/* ===== شاشة القفل ===== */
#lock{position:fixed;inset:0;z-index:100;background:var(--ink);color:#EDF2EA;
  display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px}
#lock .lt{font-size:19px;font-weight:700;margin-bottom:6px}
#lock .ls{font-size:14px;color:#A7BCA9;margin-bottom:22px;min-height:20px;text-align:center}
#lock .dots{display:flex;gap:14px;margin-bottom:30px}
#lock .dots i{width:14px;height:14px;border-radius:50%;border:2px solid #6E8672;display:block}
#lock .dots i.on{background:#EDF2EA;border-color:#EDF2EA}
#lock .pad{display:grid;grid-template-columns:repeat(3,76px);gap:14px}
#lock .pad button{height:68px;border-radius:50%;background:rgba(255,255,255,.1);color:#EDF2EA;
  font-size:26px;font-weight:600;font-variant-numeric:tabular-nums}
#lock .pad button.act{background:transparent;font-size:15px;font-weight:600;color:#A7BCA9}
#lock.err .dots{animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-9px)}75%{transform:translateX(9px)}}
</style>
</head>
<body>

<div id="lock" class="hide">
  <div class="lt">دفتر شحنات المزرعة</div>
  <div class="ls" id="lockMsg">اكتب الرقم السري</div>
  <div class="dots" id="lockDots"><i></i><i></i><i></i><i></i></div>
  <div class="pad" id="pad"></div>
</div>

<header>
  <div>
    <h1>دفتر شحنات المزرعة</h1>
    <div class="today num" id="todayLabel"></div>
  </div>
  <button class="hdr-btn" id="numToggle">١٢٣ / 123</button>
</header>

<main>

<!-- ============ تسجيل ============ -->
<section id="v-entry">
  <div id="autoCard"></div>
  <div class="card">
    <h2>شحنة جديدة</h2>

    <div class="seg kind" role="group" aria-label="نوع المحصول">
      <button data-v="خضار" aria-pressed="true"><span class="dot"></span>خضار</button>
      <button data-v="فاكهة" aria-pressed="false"><span class="dot"></span>فاكهة</button>
    </div>

    <div class="seg place" role="group" aria-label="الجهة">
      <button data-v="المنصورة" aria-pressed="true">المنصورة</button>
      <button data-v="القاهرة" aria-pressed="false">القاهرة</button>
    </div>

    <div class="field big-amount">
      <label for="eTotal">المبلغ الإجمالي</label>
      <input id="eTotal" type="text" inputmode="decimal" placeholder="0" autocomplete="off">
    </div>

    <div class="row2">
      <div class="field">
        <label for="ePaid">المدفوع</label>
        <input id="ePaid" type="text" inputmode="decimal" placeholder="0" autocomplete="off">
      </div>
      <div class="field">
        <label for="eRest">الباقي</label>
        <input id="eRest" type="text" inputmode="decimal" placeholder="0" autocomplete="off">
      </div>
    </div>
    <p class="hint" id="restHint">اكتب المدفوع أو الباقي — التاني بيتحسب لوحده. الباقي بالسالب معناه إنك مدين للتاجر.</p>

    <div class="row2">
      <div class="field">
        <label for="eDate">تاريخ الشحنة</label>
        <input id="eDate" type="date">
      </div>
      <div class="field">
        <label for="eNote">ملاحظة (اختياري)</label>
        <input id="eNote" type="text" placeholder="اسم السوق / الصنف" autocomplete="off">
      </div>
    </div>

    <button class="primary" id="saveBtn">سجّل الشحنة</button>
  </div>

  <div class="card">
    <h2>شحنات اليوم</h2>
    <div id="todayTable"></div>
  </div>
</section>

<!-- ============ السجل اليومي ============ -->
<section id="v-log" class="hide">
  <div class="card">
    <h2>سجل الأيام</h2>
    <p class="sub">كل يوم في جدول مستقل، الأحدث فوق.</p>
    <div class="chips" id="logFilter">
      <button class="chip" data-f="الكل" aria-pressed="true">الكل</button>
      <button class="chip" data-f="خضار" aria-pressed="false">خضار</button>
      <button class="chip" data-f="فاكهة" aria-pressed="false">فاكهة</button>
    </div>
  </div>
  <div id="logDays"></div>
</section>

<!-- ============ التقارير ============ -->
<section id="v-report" class="hide">
  <div class="card">
    <h2>تقرير لحظي — <span id="instDateLbl" class="num"></span></h2>
    <div class="field">
      <label for="instDate">اليوم</label>
      <input id="instDate" type="date">
    </div>
    <div class="stats" id="instStats"></div>
  </div>

  <div class="card">
    <h2>الديون الخارجية (كل الأيام)</h2>
    <p class="sub">إجمالي المستحق لك من كل جهة حتى الآن.</p>
    <div id="debtBoard"></div>
  </div>

  <div class="card">
    <h2>تقرير فترة مخصصة</h2>
    <div class="row2">
      <div class="field"><label for="rFrom">من</label><input id="rFrom" type="date"></div>
      <div class="field"><label for="rTo">إلى</label><input id="rTo" type="date"></div>
    </div>
    <div class="chips" id="rKind">
      <button class="chip" data-f="الكل" aria-pressed="true">خضار وفاكهة</button>
      <button class="chip" data-f="خضار" aria-pressed="false">خضار</button>
      <button class="chip" data-f="فاكهة" aria-pressed="false">فاكهة</button>
    </div>
    <div class="chips" id="rPlace">
      <button class="chip" data-f="الكل" aria-pressed="true">الجهتين</button>
      <button class="chip" data-f="المنصورة" aria-pressed="false">المنصورة</button>
      <button class="chip" data-f="القاهرة" aria-pressed="false">القاهرة</button>
    </div>
    <div id="rangeOut"></div>
    <button class="ghost" id="exportBtn" style="width:100%;margin-top:12px">نزّل الفترة ملف Excel</button>
  </div>
</section>

<!-- ============ الملخص ============ -->
<section id="v-summary" class="hide">
  <div class="card">
    <h2>ملخص أسبوعي</h2>
    <p class="sub">الأسبوع من الإثنين لحد الأحد.</p>
    <div id="weekTable"></div>
  </div>
  <div class="card">
    <h2>ملخص شهري</h2>
    <div id="monthTable"></div>
  </div>
  <div class="card">
    <h2>قفل التطبيق</h2>
    <p class="sub">رقم سري من ٤ أرقام يتطلب كل مرة تفتح التطبيق.</p>
    <div class="balance">
      <span class="lbl">الحالة</span>
      <span class="val" id="pinState" style="font-size:15px">مقفول</span>
    </div>
    <button class="ghost" id="pinBtn" style="width:100%;margin-top:12px">فعّل القفل</button>
  </div>

  <div class="card">
    <h2>الحفظ التلقائي</h2>
    <p class="sub">أول ما تفتح التطبيق كل يوم، بينزّل جدول اليوم اللي فات ملف Excel في مجلد التنزيلات.</p>
    <div class="balance">
      <span class="lbl">الحالة</span>
      <button class="chip" id="autoToggle" aria-pressed="true">مفعّل</button>
    </div>
    <div class="balance"><span class="lbl">آخر جدول اتحفظ</span><span class="val num" id="autoLast">—</span></div>
    <button class="ghost" id="saveDayBtn" style="width:100%;margin-top:12px">احفظ جدول النهارده دلوقتي</button>
  </div>

  <div class="card">
    <h2>البيانات</h2>
    <p class="sub" id="dataInfo"></p>
    <div class="row2">
      <button class="ghost" id="backupBtn">نزّل نسخة احتياطية</button>
      <button class="ghost" id="restoreBtn">استرجع نسخة</button>
    </div>
    <input type="file" id="restoreFile" accept=".json,application/json" class="hide">
    <p class="hint">البيانات متخزنة على تليفونك نفسه. لو مسحت بيانات المتصفح هتضيع — نزّل نسخة احتياطية كل فترة.</p>
  </div>
</section>

</main>

<nav>
  <button data-view="entry" aria-current="page">
    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>تسجيل</button>
  <button data-view="log">
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>السجل</button>
  <button data-view="report">
    <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>تقارير</button>
  <button data-view="summary">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>ملخص</button>
</nav>

<script>
"use strict";

/* ================= التخزين ================= */
const KEY_REC = "farm:records:v1";
const KEY_SET = "farm:settings:v1";
let records = [];
let settings = { arabicDigits: true, autoDaily: true, exported: [], lastAuto: null, pin: null };
let memoryOnly = false;

// التخزين: ذاكرة المتصفح على الجهاز أولًا، ولو مش متاحة نستخدم تخزين تطبيق Claude
const LS_OK = (()=>{ try{ localStorage.setItem("__t","1"); localStorage.removeItem("__t"); return true; }catch(e){ return false; } })();
let storeName = LS_OK ? "الجهاز" : "التطبيق";

async function sGet(key){
  if(LS_OK){
    const v = localStorage.getItem(key);
    if(v !== null){ try{ return JSON.parse(v); }catch(e){} }
  }
  try{ if(window.storage){ const r = await window.storage.get(key); return r ? JSON.parse(r.value) : null; } }catch(e){}
  return null;
}
async function sSet(key,val){
  let ok = false;
  const txt = JSON.stringify(val);
  if(LS_OK){ try{ localStorage.setItem(key, txt); ok = true; }catch(e){} }
  if(!ok){ try{ if(window.storage){ const r = await window.storage.set(key, txt); if(r) ok = true; } }catch(e){} }
  memoryOnly = !ok;
  return ok;
}
async function save(){
  const ok = await sSet(KEY_REC, records);
  if(!ok) toast("تحذير: مش قادر أحفظ — نزّل نسخة احتياطية حالًا");
}

/* ================= أدوات ================= */
const AR="٠١٢٣٤٥٦٧٨٩", FA="۰۱۲۳۴۵۶۷۸۹";
function toWestern(s){
  return String(s||"").replace(/[٠-٩]/g,d=>AR.indexOf(d)).replace(/[۰-۹]/g,d=>FA.indexOf(d))
    .replace(/[٫،]/g,".").replace(/[٬,]/g,"").trim();
}
function parseNum(s){
  const v = toWestern(s).replace(/[^\d.\-]/g,"");
  if(v==="" || v==="-" || v===".") return null;
  const n = parseFloat(v);
  return isNaN(n) ? null : n;
}
function digits(str){
  if(!settings.arabicDigits) return str;
  return String(str).replace(/\d/g,d=>AR[+d]);
}
function fmt(n){
  const v = Math.round((n+Number.EPSILON)*100)/100;
  let s = v.toLocaleString("en-US",{minimumFractionDigits:0,maximumFractionDigits:2});
  return digits(s);
}
function money(n){ return fmt(n); }
const pad=n=>String(n).padStart(2,"0");
function iso(d){ return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate()); }
function todayISO(){ return iso(new Date()); }
const AR_DAYS=["الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];
const AR_MONTHS=["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
function prettyDate(isoStr){
  const [y,m,d]=isoStr.split("-").map(Number);
  const dt=new Date(y,m-1,d);
  return AR_DAYS[dt.getDay()]+" "+digits(d)+" "+AR_MONTHS[m-1]+" "+digits(y);
}
function shortDate(isoStr){
  const [y,m,d]=isoStr.split("-");
  return digits(+d+"/"+ +m);
}
function esc(s){ return String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }
function toast(msg){
  document.querySelectorAll(".toast").forEach(t=>t.remove());
  const t=document.createElement("div"); t.className="toast"; t.textContent=msg;
  document.body.appendChild(t); setTimeout(()=>t.remove(),2600);
}
function restCell(r){
  const v = r.total - r.paid;
  if(Math.abs(v) < 0.005) return '<span class="settled">مسدّدة</span>';
  if(v > 0) return '<span class="due money">'+money(v)+'</span>';
  return '<span class="credit money">'+money(v)+'</span>';
}
function signed(v){
  if(Math.abs(v)<0.005) return '<span class="settled">صفر</span>';
  if(v>0) return '<span class="due">'+money(v)+'</span>';
  return '<span class="credit">'+money(v)+'</span>';
}

